# Review this file, copy it to a project as .envrc, then run `direnv allow` there.
# Nothing is allowed automatically. Leaving the directory restores the old PATH.
if [[ -d .tools/bin ]]; then PATH_add .tools/bin; fi
if [[ -d .venv/bin ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
fi
if [[ -d node_modules/.bin ]]; then PATH_add node_modules/.bin; fi
